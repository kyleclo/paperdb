{"query": "Find papers with international collaborations between US and China", "sql": "SELECT DISTINCT p.corpus_id,\n       p.title,\n       p.abstract,\n       p.year,\n       p.canonical_venue,\n       p.citation_count\nFROM Papers p\nJOIN PaperAuthors pa ON p.corpus_id = pa.corpus_id\nJOIN Authors a ON pa.author_id = a.author_id\nJOIN AuthorInstitutions ai ON a.author_id = ai.author_id\nJOIN Institutions i ON ai.institution_id = i.institution_id\nWHERE i.country_code IN ('US', 'CN')\n  AND EXISTS (\n      SELECT 1\n      FROM PaperAuthors pa_us\n      JOIN AuthorInstitutions ai_us ON pa_us.author_id = ai_us.author_id\n      JOIN Institutions i_us ON ai_us.institution_id = i_us.institution_id\n      WHERE pa_us.corpus_id = p.corpus_id\n        AND i_us.country_code = 'US'\n  )\n  AND EXISTS (\n      SELECT 1\n      FROM PaperAuthors pa_cn\n      JOIN AuthorInstitutions ai_cn ON pa_cn.author_id = ai_cn.author_id\n      JOIN Institutions i_cn ON ai_cn.institution_id = i_cn.institution_id\n      WHERE pa_cn.corpus_id = p.corpus_id\n        AND i_cn.country_code = 'CN'\n  )\nORDER BY p.citation_count DESC\nLIMIT 100", "input_tokens": 661, "output_tokens": 277, "count": 100, "expected": "", "retrieved": [8174613, 3158440, 9395040, 1389483, 5403702, 765547, 52057510, 53752874, 44072899, 4623739, 4952494, 9524495, 5628616, 53285773, 53080736, 5112038, 4882356, 12203896, 13694466, 8066499, 204902024, 139787, 51877568, 216636598, 46927617, 7752968, 53244809, 53306064, 202539031, 3544821, 102352962, 44009215, 7475429, 13741866, 3295641, 25111673, 52283296, 3662564, 19481891, 53224984, 189898081, 153312535, 18634877, 1964946, 189209, 52100101, 215745290, 15986631, 207852561, 5993783, 44144625, 174802397, 189762487, 17014226, 29162291, 59553499, 409423, 53790237, 704071, 8338282, 208910773, 52156433, 226262227, 52145657, 7586460, 216553182, 2782776, 153312687, 202583694, 216553425, 220046458, 247735, 52291855, 167217453, 56895551, 216562386, 7189219, 44063972, 53719431, 8377